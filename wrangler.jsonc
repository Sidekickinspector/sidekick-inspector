{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sidekick",
  "main": "./dist/server/index.js",
  "keep_vars": true,
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "observability": {
    "enabled": true
  }
}
